# Rustube runtime config
RUST_LOG=rustube=info,tower_http=info

# Preferred for Linux server (authenticated YouTube/Instagram cookies):
# Absolute path to Netscape cookies file
RUSTUBE_COOKIES_FILE=./cookies.txt

# Alternative to cookies file: raw Cookie header value
# Example: SID=...; HSID=...; SSID=...; SAPISID=...
RUSTUBE_COOKIES_HEADER=

# Optional browser profile cookie import (desktop systems)
RUSTUBE_COOKIES_FROM_BROWSER=

# cookie-scoop integration
RUSTUBE_COOKIE_SCOOP_ENABLED=false
RUSTUBE_COOKIE_SCOOP_BIN=/root/.cargo/bin/cookie-scoop
RUSTUBE_COOKIE_SCOOP_TIMEOUT_SECS=20
RUSTUBE_AUTO_COOKIE_BROWSER_RETRY=false
